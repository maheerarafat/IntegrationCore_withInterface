<?xml version="1.0" encoding="utf-8"?>
<Configuration_Properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <DBType>0</DBType>
  <ConnectionString>User ID= sa; Password= sa;Initial Catalog=T4 ;Connect Timeout=30; Data Source=GH</ConnectionString>
  <VersionNumber>2020.0206</VersionNumber>
  <EnableLogging>True</EnableLogging>
  <APIURL>http://AR126APPV02/TarasolAPI4</APIURL>
  <TarasolSiteURL>http://localhost/TarasolSite</TarasolSiteURL>
  <DataFolder>c:\inetpub\wwwroot\TarasolAPI4\Datafolder</DataFolder>
  <IntegrationDataFolder>C:\inetpub\wwwroot\TarasolAPI4\DataFolder\Files\DocumentsExchange</IntegrationDataFolder>
  <UploadFilesMaximumFileSize>0</UploadFilesMaximumFileSize>
  <DongleServerIP>localhost</DongleServerIP>
  <LicenseIPType>h</LicenseIPType>
  <EnableEncryption>0</EnableEncryption>
  <UserName>ESB</UserName>
  <Password>T04@OSB12c</Password>
  <log4net>
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Logs\" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd'.txt'" />
      <staticLogFileName value="false" />
      <rollingStyle value="Composite" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%thread;%message" />
      </layout>
      <LockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
    <!-- Setup the root category, add the appenders and set the default level -->
    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
    <threshold value="ON" />
  </log4net>
</Configuration_Properties>