@{
    ViewData["Title"] = "Reports";
}



<div class="row">
    <div class="col-md-4 border-report">
        <h3>Status</h3>
        <table class="table">
            <tbody>
                <tr>
                    <td width="70%">Today Date</td>
                    <td id="todayDate"></td>
                </tr>
                <tr>
                    <td>Incident(s)</td>
                    <td style="color:red;" id="incident"></td>
                </tr>
                <tr>
                    <td>Number of folder in In/Draft</td>
                    <td id="countFolderInDraft"></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="col-md-8">

    </div>
</div>

<div class="row ">

    <div class="col-md-offset-8">
        <div class="row">
            <div class="col-md-6">
                <input class="form-control" type="date" id="filterDate" name="filterDate" />
            </div>
            <div class="col-md-6">
                <button class="btn btn-default" onclick="filter()">Filter</button>
            </div>
        </div>



    </div>

</div>

<div class="row border-report">

    <div class="col-md-6">
        <h3>Resources</h3>

        <canvas id="barChart" width="400" height="200"></canvas>
    </div>
    <div class="col-md-6">
        <h3>Errors Details</h3>
        <p style="color:red;">Errors in Range date : <span id="ErrorRange"></span></p>
        <div id="details"></div>
    </div>

</div>

<script>

    let barList = [];
    let pieList = [];
    let successCount = 0;
    let failedCount = 0;
    let total = 0;
    let barChart = undefined;
    let pieChart = undefined;



    function filter() {

        let dateStr = $("#filterDate").val();
        $('#cover-spin').show(0);
        let urlRequest = '@Url.Action("GetReportJobESB", "Report")';
        let request = JSON.stringify({"Date": dateStr});
        $.ajax({
            type: 'POST',
            url: urlRequest,
            data: request,
                contentType: "application/json",
                beforeSend: function (xhdr) {
                    let token = sessionStorage['token'];
                    xhdr.setRequestHeader(
                    "Authorization", "Bearer " + token);
                }
            }).done(function (data) {


                for (var i = 0; i < data.resources.length; i++) {
                    let item = data.resources[i];
                    if (item.fldtype == 1) {
                        successCount = item.cnt;
                    }
                    else if (item.fldtype == 2) {
                        failedCount = item.cnt;
                    }
                    total += item.cnt;
                }

                $('#incident').text(data.incident);
                $('#countFolderInDraft').text(data.countFolderInDraft);
                $('#todayDate').text(data.date);
                $('#ErrorRange').text(failedCount);


                let ctxBar = document.getElementById('barChart').getContext('2d');
                if (barChart != undefined) {
                      barChart.destroy();
                }
                barChart = new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: ['فشل', 'نجاح'],
                        datasets: [{
                            label: '',
                            data: [failedCount, successCount],
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(75, 192, 192, 0.2)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(75, 192, 192, 1)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });

                // table servicesCount
                let tbl_servicesCount = "<table class='table'> <tbody>";
                for (var i = 0; i < data.servicesCount.length; i++) {
                    let item = data.servicesCount[i];
                    tbl_servicesCount += "<tr>";
                    tbl_servicesCount += `<td width='70%'>${item.fldname}</td><td>${item.cnt}</td>`;
                    tbl_servicesCount += "</tr>";
                }
                tbl_servicesCount += "<table class='table'> <tbody>";
                 $('#details').html(tbl_servicesCount);


                $('#cover-spin').css('display', 'none');
            }).error(function (xhdr, statusText, errorText) {

                $('.alert').css('display', 'block');
                $('#cover-spin').css('display', 'none');
                if (xhdr.responseText != "") {
                    $('#resMessage').text(xhdr.responseJSON.value.eMessage);
                } else
                    $('#resMessage').text(xhdr.statusText);
            });
    }

    $(document).ready(function () {

        filter();

        let urlRequest = '@Url.Action("GetReportJobESB", "Report")';
        let dateStr = $("#filterDate").val();
        let request = JSON.stringify({"Date": dateStr});
        let token = sessionStorage['token'];
        var source = new SSE(urlRequest,
            {
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': "application/json"
                },
                payload: request,
                method: 'POST'
            }
        );
        source.addEventListener('message', function(e) {

            var payload = JSON.parse(e.source.chunk);
            console.log(payload);
        });
        source.stream();

    });

    setInterval(filter, 300000)

</script>
