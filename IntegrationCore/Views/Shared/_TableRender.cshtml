
<h1> @this.ViewData["name"]</h1>
<table id="@this.ViewData["tableName"]" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
    <thead>
        <tr>
            @{
                List<IntegrationCore.ModelView.TableColumn> column = this.ViewData["column"] as List<IntegrationCore.ModelView.TableColumn>;
            }
            @for (int i = 0; i < column.Count(); i++)
            {
                <th>@column.ElementAt(i).Name</th>
            }
        </tr>
    </thead>
</table>

<environment include="ICA">
    @*<script src="~/lib/jquery/dist/jquery.js"></script>*@
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/js/dataTables.bootstrap4.min.js" asp-append-version="true"></script>
</environment>
<script>

    let columns = [
    ]

    @for (var i = 0; i < column.Count(); i++) {  // This is .NET
        if (column.ElementAt(i).Type == 0 )
        {
           @: columns.push ({ "data": '@column.ElementAt(i).Filed', "name": '@column.ElementAt(i).Name', "autoWidth": true }); // This is JS AND .NET
        } else if(column.ElementAt(i).Type == 1)
        {
            @:columns.push({"data": "@column.ElementAt(i).Filed", "name": "@column.ElementAt(i).Name", "autoWidth": true, render: function (data, type, row) {
            @:   if (type == 'sort' || type == 'type') {

            @:   }
            @:   return convertString2Date(data);
            @:}})
        } else if (column.ElementAt(i).Type == 2)
        {
            @:columns.push({data: null, render: function (data, type, row) {
            @:   return "<a href='#' class='btn btn-info' onclick=@column.ElementAt(i).Action" + "('" + row.fldid + "'); >@column.ElementAt(i).Name</a>";
            @:}})
        }
    }
    
    render_dataTable("/IntegrationCore/HR/GetHistoryUpdateHR", "sync_tbl", columns, 'cover-spin');

</script>