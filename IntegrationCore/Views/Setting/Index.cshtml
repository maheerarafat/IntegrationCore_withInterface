@{
    ViewData["Title"] = "Settings";
}


<div class="container">
    <div class="alert alert-danger" role="alert" style="display:none">
        <p id="resMessage"></p>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>




    <div class="form-horizontal">
        <hr />

        <div class="panel panel-default">
            <div class="panel-heading">Settings</div>

            <div class="panel-body">

                <div class="row">

                    <div class="col-md-6">
                        <label>DB Type</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <div class="">
                                    <label for="Oracle">Oracle</label>
                                    <input type="radio" name="DBype" id="Oracle" />
                                    <label for="SQL">SQL</label>
                                    <input type="radio" name="DBype" id="SQL" />
                                </div>
                                <div class="">

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">
                        <label>Connection String</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="ConnectionString" name="ConnectionString" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>DB Password</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="password" class="form-control" id="DBPassword" name="DBPassword" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">
                        <label>Username</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="UserName" name="UserName" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>Password</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="password" class="form-control" id="Password" name="Password" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">
                        <label>Data Folder</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="DataFolder" name="DataFolder" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>API URL</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="APIURL" name="APIURL" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">
                        <label>Integration Data Folder</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="IntegrationDataFolder" name="IntegrationDataFolder" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>Enable Send Email Time in 24 Format</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="TimeStartSendEmail" name="TimeStartSendEmail" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label>Classification</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="ClassificationId" name="ClassificationId" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>Entity Prefix</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="EntityPrefix" name="EntityPrefix" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">

                    <div class="col-md-6">
                        <label>Enable Logging</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="checkbox" id="EnableLogging" name="EnableLogging" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div>
                            <a style="cursor:pointer;" href="@Url.Action("DownloadLatestLog", "Home")"> Download latest Log</a>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label>Manual Sync</label>
                        <div class="form-group">
                            <div class="col-md-10">
                                <span onclick="manual_sync_incoming()" class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span>
                            </div>
                        </div>
                    </div>
                   
                </div>


                <div class="row">

                    <div class="col-md-6">
                        <div class="">
                            <button class="btn btn-default" onclick="save_setting()">Save</button>
                        </div>
                    </div>
                    <div class="col-md-6"></div>

                </div>



            </div>

        </div>



    </div>

</div>


<script type="text/javascript">

    var DBPassword = '';
    var Password = '';

    $(document).ready(function () {

         $('#cover-spin').show(0);
        let data = sessionStorage['token'];
        $.ajax({
            method: 'GET',
            url: '@Url.Action("GetSettings", "Setting")',
            beforeSend: function (xhdr) {
                xhdr.setRequestHeader(
                    "Authorization", "Bearer " + data);
            }
        }).done(function (data) {
            debugger
            $('#cover-spin').css('display', 'none');
            $('#ConnectionString').val(data.connectionString);
            DBPassword = data.dbPassword;
            $('#UserName').val(data.userName);
            Password = data.password;
            $('#APIURL').val(data.apiurl);
            $('#IntegrationDataFolder').val(data.integrationDataFolder);
            $('#DataFolder').val(data.dataFolder);
            $('#EnableLogging').prop('checked', data.enableLogging);
            $('#TimeStartSendEmail').val(data.timeStartSendEmail);
            $('#ClassificationId').val(data.classificationId);
            $('#EntityPrefix').val(data.entityPrefix);
            if (data.dbType == 1)
                $('#Oracle').prop('checked', data.dbType)
            else
                 $('#SQL').prop('checked', data.dbType)

        }).error(function (xhdr, statusText, errorText) {
            $('.alert').css('display', 'block');
            $('#cover-spin').css('display', 'none');
            if (xhdr.responseText != "") {
                $('#resMessage').text(xhdr.responseJSON.value.eMessage);
            } else if (xhdr.statusText == "Unauthorized") {
                $('#resMessage').text(xhdr.statusText);
                CallBackUnauthorized();
            }
            else
                $('#resMessage').text(xhdr.statusText);
        });

    });

    function save_setting() {

        let dbType = 1;
        let enableLogging = false;
        if ($('#Oracle').prop('checked')) {
            dbType = 1;
        } else {
            dbType = 2;
        }

        if ($('#DBPassword').val() != '' ) {
            DBPassword = $('#DBPassword').val();
        }
        if ($('#Password').val() != '') {
            Password = $('#Password').val();
        }

        if ($('#EnableLogging').prop('checked')) {
            enableLogging = true;
        }

        $('#cover-spin').show(0);

        let request = JSON.stringify({
            'ConnectionString': $('#ConnectionString').val(),
            'UserName': $('#UserName').val(),
            'APIURL': $('#APIURL').val(),
            'IntegrationDataFolder': $('#IntegrationDataFolder').val(),
            'DataFolder': $('#DataFolder').val(),
            'EnableLogging': enableLogging,
            'DBType': dbType,
            'DBPassword': DBPassword,
            'Password': Password,
            "TimeStartSendEmail": $('#TimeStartSendEmail').val(),
            "ClassificationId": $('#ClassificationId').val(),
            "EntityPrefix": $('#EntityPrefix').val()
        });
        $.ajax({
                type: 'POST',
                url: '@Url.Action("EditSettings", "Setting")',
                data: request,
                contentType: "application/json",
                beforeSend: function (xhdr) {
                    let token = sessionStorage['token'];
                    xhdr.setRequestHeader(
                    "Authorization", "Bearer " + token);
                }
            }).done(function (data) {

                 $('#cover-spin').css('display', 'none');
            }).error(function (xhdr, statusText, errorText) {

                $('.alert').css('display', 'block');
                $('#cover-spin').css('display', 'none');
                if (xhdr.responseText != "") {
                    $('#resMessage').text(xhdr.responseJSON.value.eMessage);
                } else
                    $('#resMessage').text(xhdr.statusText);
            });
    }

    function downloadLog() {

        let data = sessionStorage['token'];
        $.ajax({
            method: 'GET',
            url: '@Url.Action("DownloadLatestLog", "Home")',
            beforeSend: function (xhdr) {
                xhdr.setRequestHeader(
                    "Authorization", "Bearer " + data);
            }
        }).done(function (data) {

            window.Location = data
        }).error(function (xhdr, statusText, errorText) {
            $('.alert').css('display', 'block');
            $('#cover-spin').css('display', 'none');
            if (xhdr.responseText != "") {
                $('#resMessage').text(xhdr.responseJSON.value.eMessage);
            } else
                $('#resMessage').text(xhdr.statusText);
        });
    }


    function manual_sync_incoming() {

        debugger;
        $('#cover-spin').show(0);
        let data = sessionStorage['token'];
        $.ajax({
            method: 'GET',
            url: '@Url.Action("ManualSyncImporting", "Setting")',
            beforeSend: function (xhdr) {
                xhdr.setRequestHeader(
                    "Authorization", "Bearer " + data);
            }
        }).done(function (data) {

            $('#cover-spin').css('display', 'none');
            debugger;

        }).error(function (xhdr, statusText, errorText) {
            $('.alert').css('display', 'block');
            $('#cover-spin').css('display', 'none');
            if (xhdr.responseText != "") {
                $('#resMessage').text(xhdr.responseJSON.value.eMessage);
            } else
                $('#resMessage').text(xhdr.statusText);
        });
    }

</script>
