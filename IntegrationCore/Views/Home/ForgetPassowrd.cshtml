@model IntegrationCore.Models.SettingModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <title></title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />


    @*<link rel="stylesheet" href="~/css/reset_password/jqm-demos.css" />*@
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <link href="~/lib/jqm1.4.5/rtl.jquery.mobile-1.4.5.css" rel="stylesheet" />
    @*<link href="~/lib/jqm1.4.5/jqm-demos.css" rel="stylesheet" />*@
    @*<script src="~/js/reset_password/jquery.js" type="text/javascript"></script>*@
    <script src="~/lib/jqm1.4.5/rtl.jquery.mobile-1.4.5.js"></script>
    @*<link href="~/lib/jqm1.4.5/theme-classic.css" rel="stylesheet" />*@

    <style type="text/css">
        @@media (min-width: 0px) {
            #loginformdialog {
                margin: 0 10%;
            }

            .logoDiv {
                width: 90%;
                margin: 2% auto 1em auto;
                padding: 0;
                position: relative;
                text-align: center;
            }

            div.ui-dialog-contain {
                width: 90%;
                max-width: none;
                margin: 3% auto 1em auto;
                border: 0;
            }

            .submit-button {
                width: 90%;
                margin: 0 auto 1em auto;
                padding: 0;
                position: relative;
                display: flex;
            }

            .ui-field-contain {
                margin: 1.5em 0;
                border: 0;
            }

                .ui-field-contain > label {
                    width: 100%;
                }

                    .ui-field-contain > label ~ [class*="ui-"] {
                        width: 100%;
                    }
        }



        #loginformcontent {
            box-shadow: 0 0 4px #c7c7c7;
        }

        #otppanel {
            box-shadow: 0 0 4px #c7c7c7;
        }

        #loginform {
            border-top: 3px solid #9c6f31;
        }

        @@media (min-width: 500px) {

            #loginformdialog {
                margin: 0 10%;
            }

            .logoDiv {
                width: 30%;
                margin: 2% auto 1em auto;
                padding: 0;
                position: relative;
                text-align: center;
                min-width: 350px;
            }

            div.ui-dialog-contain {
                width: 30%;
                max-width: none;
                margin: 3% auto 1em auto;
                min-width: 350px;
            }

            .submit-button {
                width: 80%;
                margin: 0 auto 1em auto;
                padding: 0;
                position: relative;
                min-width: 350px;
                display: flex;
            }

            .ui-field-contain {
                margin: 1.5em 0;
            }

                .ui-field-contain > label {
                    width: 28%;
                }

                    .ui-field-contain > label ~ [class*="ui-"] {
                        width: 70%;
                    }
        }

        .language-first-div {
            margin: 0;
            width: 50%;
            min-width: 0;
            display: inline-block;
            text-align: left;
        }

        body[dir=ltr] .language-first-div {
            text-align: right;
        }

        .language-second-div {
            margin: 0;
            width: 50%;
            min-width: 0;
            display: inline-block;
            text-align: right;
            padding: .5em 0;
        }

        body[dir=rtl] .language-second-div {
            text-align: left;
        }

        .main-div {
            display: flex;
        }

            .main-div span {
                font-size: 1.083rem;
                font-weight: normal;
            }

        .ui-checkbox {
            margin: 0;
        }

        #btnAction {
            height: 3.5em;
            height: 3.5em;
            background: #cd1f2f;
            color: #fff;
            border: 0;
            font-weight: lighter;
            margin: 0.3em;
        }

        #btnChangeMobile {
            margin: 0.3em;
        }

        #englishLan {
            vertical-align: text-bottom;
            cursor: pointer;
        }

        #arabicLan {
            vertical-align: top;
            cursor: pointer;
        }

        div#loginform.bk {
        }

        /************ No cookies design ************/
        #noCookies div[data-role="page"] {
            display: none;
        }

        #noCookies div {
            margin: 1em;
            text-align: center;
            direction: ltr;
        }

        #noCookies .disabledJavaScript {
            border: 3px solid #398fc7;
            margin: 1em 25%;
            color: #ee1212;
            border-radius: 10px;
        }


        /** Dark Mode **/

        body.dark-mode #loginform {
            -moz-filter: invert(1) grayscale(1);
            -webkit-filter: invert(1) grayscale(1);
            filter: invert(1) grayscale(1);
        }

        body[data-theme="a"].dark-mode #loginform {
            -moz-filter: grayscale(1);
            -webkit-filter: grayscale(1);
            filter: grayscale(1);
        }

        body.dark-mode:not([data-theme="a"]) img {
            -moz-filter: invert(1);
            -webkit-filter: invert(1);
            filter: invert(1);
        }

        body:not([data-theme="a"]).dark-mode span:not(.inverted) {
            color: black !important;
        }

        body[data-theme="b"].dark-mode span.inverted {
            color: black !important;
        }

        body:not([data-theme="a"]):not([data-theme="b"]).dark-mode-parent span.inverted {
            color: white !important;
        }

        .gray-scall {
            -moz-filter: grayscale(1);
            -webkit-filter: grayscale(1);
            filter: grayscale(1);
        }

        /*custom style*/
        #txtUserName, #txtUserOTP, #txtNewPassword, #txtNewPasswordC {
            text-align: center;
        }

        #txtMobile {
            text-align: center;
            direction: ltr;
        }
    </style>
</head>
<body>
    <div id="cover-spin"></div>
    <div id="cover-message">
        <div id="cover-message-inner">

        </div>
        <div class="bk ui-corner-all">
            
        </div>
        
    </div>

    @*begin body*@
<id ="mainpage" style="width: 97%; height: 97%; vertical-align: middle;" class=" ">

    <input type="hidden" value="" id="APIURLField" runat="server" />
    <div style="width: 100%; height: 100%;" id="controls">


        <input type="hidden" value="0" id="hiddenlangvalue" runat="server" />

        <input type="hidden" value="" id="externallink" name="externallink" runat="server" />
        <input type="hidden" value="" id="templatename" name="templatename" runat="server" />
        <input type="hidden" value="" id="activityuid" name="activityuid" runat="server" />

        <div id="noCookies" runat="server" style="display: none;">
            <div>
                <img style="max-width: 100%;" src="" />
            </div>
            <div class="disabledJavaScript">
                <div style="font-size: 1.667rem;">Cookies are disabled</div>
                <div style="color: #154b87;">Please enable Cookies and refresh the page!</div>
            </div>
        </div>
        <div data-role="page" id="loginform" class="bk ui-corner-all" data-ajax="false">




            <div class=" ui-corner-all " data-ajax="false" id="loginformdialog">

                @*main frame*@
                <div data-role="content" id="loginformcontent" style=" display: block; filter: alpha(opacity=87);">
                    <div data-role="fieldcontain" id="divUserName">
                        <label for="txtUserName">
                            <span runat="server" id="spUserName">رقم المستخدم</span>
                        </label>
                        <input type="text" name="txtUserName" id="txtUserName" value="" runat="server" />

                    </div>
                    <div data-role="fieldcontain" style="display: none;" id="divMobile">
                        <label for="txtMobile">
                            <span id="spMobile" resourceid="resTarasolLoginSpnMobile">رقم الموبايل</span>
                        </label>
                        <input disabled type="text" name="txtMobile" autocomplete="off" id="txtMobile" value="" runat="server" />

                    </div>
                </div>

                @*opt frame*@
                <div data-role="content" id="otppanel" style="display: none; filter: alpha(opacity=87);">
                    <div style="color:red;"><span id="time">04:00</span> دقائق سوف يتم إنهاء العملية!</div>
                    <div data-role="fieldcontain" id="divUserOTP">
                        <label for="txtUserOTP" style="padding-top: 7px;">
                            <span runat="server" id="spUserOTP">رمز التأكيد</span>
                        </label>
                        <input type="text" name="txtUserOTP" id="txtUserOTP" value="" runat="server" />

                    </div>
                    <div data-role="fieldcontain" style="display: none;" id="divNewPassword">
                        <label for="txtNewPassword">
                            <span id="spNewPassword" resourceid="resTarasolLoginSpnMobile">كلمة السر الجديدة</span>
                        </label>
                        <input type="password" name="txtNewPassword" autocomplete="off" id="txtNewPassword" value="" runat="server" />
                        <label for="txtNewPasswordC">
                            <span id="spNewPasswordC" resourceid="resTarasolLoginSpnMobile">تأكيد الكلمة</span>
                        </label>
                        <input type="password" name="txtNewPasswordC" autocomplete="off" id="txtNewPasswordC" value="" runat="server" />
                    </div>

                </div>

                @*change mobile number*@
                <div data-role="content" id="changemobileformcontent" style=" display: none; filter: alpha(opacity=87);">
                    <div data-role="fieldcontain" id="divNewUserName">
                        <label for="txtNewUserName" style="padding-top: 7px;">
                            <span runat="server" id="spUserName">رقم المستخدم</span>
                        </label>
                        <input type="text" name="txtNewUserName" id="txtNewUserName" value="" runat="server" />

                    </div>
                    <div data-role="fieldcontain" id="divNewUserHR">
                        <label for="txtNewUserHR" style="padding-top: 7px;">
                            <span runat="server" id="spUserName">رقم الموظف</span>
                        </label>
                        <input type="text" name="txtNewUserHR" id="txtNewUserHR" value="" runat="server" />

                    </div>
                    <div data-role="fieldcontain" id="divNewMobile">
                        <label for="txtNewMobile">
                            <span id="spMobile" resourceid="resTarasolLoginSpnMobile">رقم الموبايل</span>
                        </label>
                        <input type="text" name="txtNewMobile" autocomplete="off" id="txtNewMobile" value="" runat="server" />
                    </div>
                    <div data-role="fieldcontain" id="divNewEmail">
                        <label for="txtNewEmail">
                            <span id="spMobile" resourceid="resTarasolLoginSpnMobile">الايميل</span>
                        </label>
                        <input type="text" name="txtNewEmail" autocomplete="off" id="txtNewEmail" value="" runat="server" />
                    </div>
                </div>

            </div>

            <div class="submit-button">
                <button id="btnAction" name="btnAction" onclick="get_mobile()">
                    <span id="btnResource" class="inverted" resourceid="resTarasolLoginSpnLogin">تأكيد</span>
                </button>
            </div>
            <div class="submit-button">
                <button id="btnTryAgain" name="btnAction" onclick="window.location.reload()">
                    <span id="btnbtnTryAgainResource" class="inverted" resourceid="resTarasolLoginSpnLogin">إعادة المحاولة</span>
                </button>
            </div>

            <div id="PageFooter" style="align-content: center;">
                <div class="logoDiv">
                    <h4 id="message_error" style="color:red;"></h4>
                    @*<img style="max-width: 100%;" src="~/images/reset_password/MainLogo.png" />*@
                </div>
                <div id="footerimg" runat="server" style="border : none; overflow: hidden; width: 100%; height: 100%;"></div>
            </div>
        </div>

    </div>
    
    @*end body*@

    <script src="~/js/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <link href="~/lib/jqm1.4.5/theme-d.css" rel="stylesheet" />
    <link href="~/lib/jqm1.4.5/theme-e.css" rel="stylesheet" />
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>

        var mb_number = '';
        var var_otp = '';
        var user_id = '';
        var cuurent_window_page = this;
        var user_number = '';

        function get_mobile() {
            $('#message_error').text('');
            let num = $('#txtUserName').val();
            user_number = num;
            $('.alert').css('display', 'none');
            $('#cover-spin').show(0);
            $.ajax(
                {
                    type: 'POST',
                    url: '/IntegrationCore/HR/GetUserMobileLookup',
                    data: JSON.stringify({ 'Username': num }),
                    contentType: "application/json",
                    success: function (data) {
                        $('#cover-spin').css('display', 'none');
                        $('#divMobile').css('display', 'block');

                        $('#btnChangeMobile').css('display', 'block');

                        if (data.value[0] != undefined) {
                            mb_number = data.value[0].mobilE_NO;
                            if (mb_number == "") {
                                $('#cover-spin').css('display', 'none');

                                $('#message_error').text('لا يوجد رقم موبايل لهذا المستخدم');

                                $('#btnChangeMobile').css('display', 'block');
                                $('#btnAction').css('display', 'none');
                            } else {
                                $('#txtMobile').val(mb_number.replaceAt(3, "****")); //
                                $('#btnAction').attr('onclick', 'send_otp()');
                                $('#btnResource').text('إرسال رمز التأكيد');
                                var fiveMinutes = 60 * 4,
                                    display = document.querySelector('#time');
                                startTimer(fiveMinutes, display);//need work
                            }

                        }
                    },
                    error: function (xhr, error, code) {
                        $('#cover-spin').css('display', 'none');
                        if (code == 'Not Found') {
                            $('#message_error').text('معلومات المستخدم غير صحيحة');
                        }
                        $('#btnChangeMobile').css('display', 'block');
                        $('#btnAction').css('display', 'none');
                    }
                }
            );
        }


        function send_otp() {
            $('#message_error').text('');
            $('.alert').css('display', 'none');
            $('#btnChangeMobile').css('display', 'none');
            $('#cover-spin').show(0);
            $.ajax(
                {
                    type: 'POST',
                    url: '/IntegrationCore/SMS/SendOTP',
                    data: JSON.stringify({ 'ecs': user_number, 'mobile': mb_number }),
                    contentType: "application/json",
                    success: function (data) {
                        $('#cover-spin').css('display', 'none');
                        $('#loginformcontent').css('display', 'none');
                        $('#otppanel').css('display', 'block');
                        var_otp = data.value;
                        $('#btnAction').attr('onclick', 'check_otp()');
                        $('#btnResource').text('تأكيد');
                    },
                    error: function (xhr, error, code) {
                        $('#cover-spin').css('display', 'none');
                        if (xhr.status == 500) {
                            $('#message_error').text("لا يمكن إرسال رسالة إلى هذا الرقم - الرجاء التحقق من صحة الرقم أو توفر الخدمة");
                        } else {
                            $('#message_error').text(code);
                        }
                    }
                }
            );
        }


        function check_otp() {

            $('#message_error').text('');
            $('.alert').css('display', 'none');
            $('#cover-spin').show(0);
            $.ajax(
                {
                    type: 'POST',
                    url: '/IntegrationCore/Home/CheckOTP',
                    data: JSON.stringify({ 'ecs': user_number, 'code': $('#txtUserOTP').val() }),
                    contentType: "application/json",
                    success: function (data) {
                        $('#cover-spin').css('display', 'none');
                        if (data.value.code == 1) {
                            $('#divNewPassword').css('display', 'block');

                            $('#btnAction').attr('onclick', 'change_password()');
                            $('#btnResource').text('تأكيد');
                        } else {
                            $('#message_error').text(data.value.lMessage);
                        }
                    },
                    error: function (xhr, error, code) {
                        $('#cover-spin').css('display', 'none');
                        $('#message_error').text(code);
                    }
                }
            );
        }


        function change_password() {

            $('#message_error').text('');
            if ($('#txtNewPassword').val() != $('#txtNewPasswordC').val()) {
                $('#message_error').text('لا تتطابق كلمة المرور مع تأكيدها');
                return;
            }
            if ($('#txtNewPassword').val().length < 8) {
                $('#message_error').text('كلمة المرور الجديدة يجب ان تتألف من 8 أحرف علي الأقل');
                return;
            }
            $('.alert').css('display', 'none');
            $('#cover-spin').show(0);
            $.ajax(
                {
                    type: 'POST',
                    url: '/IntegrationCore/Home/ChangePassword',
                    data: JSON.stringify({ 'Username': user_number, 'Password': $('#txtNewPassword').val(), 'OTP': $('#txtUserOTP').val() }),
                    contentType: "application/json",
                    success: function (data) {
                        $('#cover-spin').css('display', 'none');
                        if (data.value.code == 1) {
                            $('#cover-message').show(0);
                            $('#controls').css('display', 'none');
                            $('#cover-message-inner').text('تم تغير كلمة المرور');
                            setTimeout(function () {
                                cuurent_window_page.close();
                            }, 3000);
                        }
                    },
                    error: function (xhr, error, code) {
                        $('#cover-spin').css('display', 'none');

                    }
                }
            );
        }

        String.prototype.replaceAt = function (index, replacement) {
            return this.substr(0, index) + replacement + this.substr(index + replacement.length);
        }

        function startTimer(duration, display) {
            var timer = duration, minutes, seconds;
            setInterval(function () {
                minutes = parseInt(timer / 60, 10)
                seconds = parseInt(timer % 60, 10);

                minutes = minutes < 10 ? "0" + minutes : minutes;
                seconds = seconds < 10 ? "0" + seconds : seconds;

                display.textContent = minutes + ":" + seconds;

                if (--timer < 0) {
                    $('#cover-message').show(0);
                    $('#cover-message-inner').text('تم إنهاء العملية');
                    timer = duration;
                    window.location.reload();
                }
            }, 1000);
        }

    </script>

</body>
</html>




