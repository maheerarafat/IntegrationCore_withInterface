<?xml version = '1.0' encoding = 'UTF-8'?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotificationSchema"
            targetNamespace="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotificationSchema"
            elementFormDefault="qualified" xmlns:nxsd="http://xmlns.oracle.com/pcbpel/nxsd" nxsd:version="JSON"
            nxsd:encoding="US-ASCII">
  <xsd:element name="EmailNotificationRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="EmailTo">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element maxOccurs="unbounded" name="email" type="xsd:string"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="EmailFrom" type="xsd:string" minOccurs="0"/>
        <xsd:element name="EmailCC">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element maxOccurs="unbounded" name="email" type="xsd:string"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="EmailSubject" type="xsd:string" minOccurs="1"/>
        <xsd:element name="EmailContent" type="xsd:string" minOccurs="1"/>
        <xsd:element name="Attachments" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Attachment" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="ContentType" type="xsd:string" minOccurs="1"/>
                    <xsd:element name="FileName" type="xsd:string" minOccurs="1"/>
                    <xsd:element name="Body" type="xsd:base64Binary" minOccurs="1"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="EmailNotificationResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="Status" type="xsd:decimal" minOccurs="1"/>
        <xsd:element name="ResponseMessage" type="xsd:string" minOccurs="1"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>