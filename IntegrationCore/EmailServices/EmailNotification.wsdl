<?xml version= '1.0' encoding= 'UTF-8' ?>
<wsdl:definitions
     name="sendEmailNotification"
     targetNamespace="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotification"
     xmlns:tns="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotification"
     xmlns:inp1="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotificationSchema"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema"
     xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
     xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    >
    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotificationSchema" schemaLocation="../Schemas/EmailNotification.xsd"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="requestMessage">
        <wsdl:part name="request" element="inp1:EmailNotificationRequest"/>
    </wsdl:message>
    <wsdl:message name="replyMessage">
        <wsdl:part name="reply" element="inp1:EmailNotificationResponse"/>
    </wsdl:message>
    <wsdl:portType name="EmailNotification_ptt">
        <wsdl:operation name="sendEmailNotification">
            <wsdl:input message="tns:requestMessage"/>
            <wsdl:output message="tns:replyMessage"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="EmailNotification_bind" type="tns:EmailNotification_ptt">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="sendEmailNotification">
            <soap:operation style="document" soapAction="sendEmailNotification"/>
            <wsdl:input>
                <soap:body use="literal" namespace="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotification"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal" namespace="http://www.moi.gov.ae/2020/MoiIntegration/EmailNotification"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
</wsdl:definitions>
